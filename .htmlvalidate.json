{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "no-trailing-whitespace": "off",
    "long-title": "off",
    "attr-case": "off",
    "valid-id": "off",
    "no-implicit-button-type": "off",
    "element-name": ["error", { "whitelist": ["helmet"] }]
  }
}
